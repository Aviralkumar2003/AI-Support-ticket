# LLM Provider (Groq offers a free API tier: https://console.groq.com)
LLM_PROVIDER=groq
LLM_MODEL=groq/llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key_here

# App
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Storage
SESSION_DIR=app/data/sessions
FAQ_FILE=app/data/faqs.json

# Workflow
MAX_JUDGE_RETRIES=2
